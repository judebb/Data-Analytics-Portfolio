--Payment Method Sums (Revenue)
SELECT
  Payment_Mode,
  COUNT(*) AS Payment_Mode_Count,
  SUM(Total_Amount) AS total_revenue
FROM `curious-ocean-470707-q6.sql_practice.sales_data`
GROUP BY Payment_Mode
ORDER BY total_revenue DESC;


--Order Status Counts 
SELECT 
  Order_Status, 
  COUNT(*) AS Order_Status_Count
  FROM `curious-ocean-470707-q6.sql_practice.sales_data`
GROUP BY Order_Status
ORDER BY Order_Status_Count DESC


--Top 10 states by number of orders --
SELECT 
  State, 
  COUNT (*) AS Orders_by_State
  FROM 'curious-ocean-470707-q6.sql_practice.sales_data'
GROUP BY State
ORDER BY Orders_by_State DESC
LIMIT 10


-- Coupon usage split --
SELECT
  CASE WHEN Coupon_Code IS NULL THEN 'NO COUPON' ELSE 'COUPON' END AS         coupon_used,
  COUNT(*) AS num_orders
FROM `curious-ocean-470707-q6.sql_practice.sales_data`
GROUP BY coupon_used;


